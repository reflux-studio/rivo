---
import '../styles/site.css'
import { site, type Locale } from '../i18n/site'
import { REPO, skillUrl } from '../lib/data'
import Collaboration from './Collaboration'
import Start from './Start'
interface Props { lang: Locale }
const { lang } = Astro.props
const t = site[lang]
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const home = { zh: `${base}/`, en: `${base}/en/` }
const url = new URL(home[lang], Astro.site)
const sectionIds = ['roles', 'collaboration', 'control', 'start']
---
<!doctype html>
<html lang={t.meta.htmlLang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#f6f3ea" />
  <title>{t.meta.title}</title>
  <meta name="description" content={t.meta.description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={url} />
  <meta property="og:title" content={t.meta.title} />
  <meta property="og:description" content={t.meta.description} />
  <link rel="canonical" href={url} />
  <link rel="alternate" hreflang="zh" href={new URL(home.zh, Astro.site)} />
  <link rel="alternate" hreflang="en" href={new URL(home.en, Astro.site)} />
  <link rel="alternate" hreflang="x-default" href={new URL(home.zh, Astro.site)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
</head>
<body>
  <div class="grain" aria-hidden="true"></div>
  <a class="skip" href="#roles">{t.skip}</a>
  <header class="site-header">
    <a class="wordmark" href={home[lang]} aria-label="Rivo">Rivo<span class="brand-dot" aria-hidden="true"></span></a>
    <nav class="desktop-nav" aria-label={lang === 'zh' ? '主导航' : 'Main navigation'}>{t.nav.map((label, i) => <a href={`#${sectionIds[i]}`}>{label}</a>)}</nav>
    <div class="header-tools"><div class="language-switch" role="group" aria-label="Language"><a href={home.zh} hreflang="zh" aria-current={lang === 'zh' ? 'page' : undefined}>中</a><a href={home.en} hreflang="en" aria-current={lang === 'en' ? 'page' : undefined}>EN</a></div><a class="source-link" href={REPO}>GitHub ↗</a></div>
    <details class="mobile-nav"><summary aria-label={lang === 'zh' ? '打开导航' : 'Open navigation'}>☰</summary><nav aria-label={lang === 'zh' ? '移动导航' : 'Mobile navigation'}>{t.nav.map((label, i) => <a href={`#${sectionIds[i]}`}>{label}</a>)}</nav></details>
  </header>
  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-intro"><div><p class="eyebrow"><span class="signal" aria-hidden="true"></span>{t.eyebrow}</p><h1 id="hero-title">{t.headline[0]}<br /><em>{t.headline[1]}</em></h1></div><div class="hero-aside"><p>{t.intro}</p><div class="hero-actions"><a class="button" href="#roles">{t.start}<span aria-hidden="true">↗</span></a><a class="text-link" href={REPO}>{t.source} ↗</a></div></div></div>
      <div class="hero-caption"><span>{t.heroNote}</span><span aria-hidden="true">SCROLL TO EXPLORE ↓</span></div>
      <div class="workspace" aria-label={t.boardLabel}>
        <div class="workspace-top"><span class="tiny-label"><span class="signal" aria-hidden="true"></span>{t.boardLabel}</span><span>{t.example}</span></div>
        <div class="workspace-title"><h2>{t.boardTitle}</h2><div class="issue-token"><code>issue.md</code><span>{t.boardIssue}</span></div></div>
        <div class="workspace-roles">{t.roles.map((role, i) => <div class={`workspace-role ${role.id}`}><div class="role-marker"><span>0{i + 1}</span><strong>{role.name}</strong></div><ul>{role.files.map(file => <li><span class="file-icon" aria-hidden="true"></span>{file}</li>)}</ul><div class="ownership-line" aria-hidden="true"></div></div>)}</div>
        <div class="workspace-base"><div><span class="foundation-mark" aria-hidden="true"></span><b>{t.foundation}</b><span>{t.foundationDesc}</span></div><span>{t.boardFooter}</span></div>
      </div>
    </section>

    <section class="section roles-section" id="roles" aria-labelledby="roles-title">
      <div class="section-heading"><p class="eyebrow">{t.rolesLabel}</p><div class="heading-row"><h2 id="roles-title">{t.rolesTitle}</h2><p>{t.rolesIntro}</p></div></div>
      <div class="role-cards">{t.roles.map((role, i) => <article class={`role-card ${role.id}`}><div class="role-identity"><div class="role-card-top"><span class="role-number">0{i + 1}</span><span class="tiny-label">{role.en}</span></div><h3>{role.name}</h3><code class="package-name">{role.package}</code></div><div class="role-content"><p class="role-verb">{role.verb}</p><p class="role-description">{role.description}</p><dl><dt>{t.input}</dt><dd>{role.input}</dd><dt>{t.output}</dt><dd>{role.output}</dd></dl><details class="skill-details"><summary>{t.skillsLabel}<span>{role.skills.length} {t.skillUnit}<span aria-hidden="true"> +</span></span></summary><ul>{role.skills.map(([name, desc]) => <li><a href={skillUrl(name)}><span>{desc}</span><code>{name} ↗</code></a></li>)}</ul></details></div></article>)}</div>
      <div class="shared-methods"><div><span class="foundation-mark" aria-hidden="true"></span><code>rivo</code><h3>{t.sharedTitle}</h3><p>{t.sharedDesc}</p></div><ul>{t.sharedSkills.map(([name, desc]) => <li><a href={skillUrl(name)}><span>{desc}</span><code>{name} ↗</code></a></li>)}</ul></div>
    </section>

    <section class="collab-section" id="collaboration" aria-labelledby="collab-title"><div class="section">
      <div class="section-heading"><p class="eyebrow">{t.collabLabel}</p><div class="heading-row"><h2 id="collab-title">{t.collabTitle}</h2><p>{t.collabIntro}</p></div></div>
      <Collaboration client:load t={t} />
      <div class="thin-record"><div><code>issue.md</code><h3>{t.thinTitle}</h3><p>{t.thinDesc}</p></div><div class="index-sample"><span class="tiny-label">{t.boardIssue}</span><div><span>10:42</span><span>{t.roles[1].name} → {t.roles[0].name}</span><span>↗ C-01</span></div><div><span>14:08</span><span>{t.roles[2].name} → {t.roles[1].name}</span><span>↗ C-02</span></div><small>{t.boardIssueDesc}</small></div></div>
      <p class="communication-note"><span aria-hidden="true">↳</span>{t.communication}</p>
    </div></section>

    <section class="section control-section" id="control" aria-labelledby="control-title"><div class="section-heading"><p class="eyebrow">{t.controlLabel}</p><div class="heading-row"><h2 id="control-title">{t.controlTitle}</h2><p>{t.controlIntro}</p></div></div><div class="context-cards">{t.contextCards.map(([title, body, note], i) => <article><span class="context-symbol" aria-hidden="true">{`0${i + 1}`}</span><h3>{title}</h3><p>{body}</p><span class="context-note">{note}</span></article>)}</div><p class="human-contract"><span class="brand-dot" aria-hidden="true"></span>{t.contract}</p></section>

    <section class="start-section" id="start" aria-labelledby="start-title"><div class="section"><div class="section-heading"><p class="eyebrow">{t.stLabel}</p><h2 id="start-title">{t.stTitle}</h2></div><Start client:load t={t} /></div></section>
  </main>
  <footer class="site-footer"><div><a class="wordmark" href={home[lang]}>Rivo<span class="brand-dot" aria-hidden="true"></span></a><p>{t.footLine}</p><a class="text-link" href={REPO}>{t.footSource} ↗</a></div><div class="footer-bottom"><span>{t.footNote}</span><nav aria-label="Resources"><a href={`${REPO}/blob/main/README.md`}>README ↗</a><a href={`${REPO}/blob/main/CONTRIBUTING.md`}>CONTRIBUTING ↗</a><a href={`${REPO}/blob/main/LICENSE`}>LICENSE ↗</a></nav><span>© 2026 reflux-studio</span></div><div class="footer-signature" aria-hidden="true">Rivo<i></i></div></footer>
  <script>
    document.querySelectorAll('.mobile-nav a').forEach(link => link.addEventListener('click', () => link.closest('details')?.removeAttribute('open')))
  </script>
</body>
</html>
