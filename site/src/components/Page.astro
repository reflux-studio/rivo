---
import '../styles/site.css'
import { site, type Locale } from '../i18n/site'
import { REPO, skillUrl } from '../lib/data'
import Collaboration from './Collaboration'
import Start from './Start'
interface Props { lang: Locale }
const { lang } = Astro.props
const t = site[lang]
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const home = { zh: `${base}/`, en: `${base}/en/` }
const url = new URL(home[lang], Astro.site)
const sectionIds = ['why', 'journey', 'roles', 'start']
---
<!doctype html>
<html lang={t.meta.htmlLang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#f6f3ea" />
  <title>{t.meta.title}</title>
  <meta name="description" content={t.meta.description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={url} />
  <meta property="og:title" content={t.meta.title} />
  <meta property="og:description" content={t.meta.description} />
  <link rel="canonical" href={url} />
  <link rel="alternate" hreflang="zh" href={new URL(home.zh, Astro.site)} />
  <link rel="alternate" hreflang="en" href={new URL(home.en, Astro.site)} />
  <link rel="alternate" hreflang="x-default" href={new URL(home.zh, Astro.site)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
</head>
<body>
  <div class="grain" aria-hidden="true"></div>
  <a class="skip" href="#why">{t.skip}</a>
  <header class="site-header">
    <a class="wordmark" href={home[lang]} aria-label="Rivo">Rivo<span class="brand-dot" aria-hidden="true"></span></a>
    <nav class="desktop-nav" aria-label={lang === 'zh' ? '主导航' : 'Main navigation'}>{t.nav.map((label, i) => <a href={`#${sectionIds[i]}`}>{label}</a>)}</nav>
    <div class="header-tools"><div class="language-switch" role="group" aria-label="Language"><a href={home.zh} hreflang="zh" aria-current={lang === 'zh' ? 'page' : undefined}>中</a><a href={home.en} hreflang="en" aria-current={lang === 'en' ? 'page' : undefined}>EN</a></div><a class="source-link" href={REPO}>GitHub ↗</a></div>
    <details class="mobile-nav"><summary aria-label={lang === 'zh' ? '打开导航' : 'Open navigation'}>☰</summary><nav aria-label={lang === 'zh' ? '移动导航' : 'Mobile navigation'}>{t.nav.map((label, i) => <a href={`#${sectionIds[i]}`}>{label}</a>)}</nav></details>
  </header>
  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-intro">
        <div><p class="eyebrow"><span class="signal" aria-hidden="true"></span>{t.eyebrow}</p><h1 id="hero-title">{t.headline.map((line, i) => <><span class:list={[i === t.headline.length - 1 && 'hero-emphasis']}>{line}</span>{i < t.headline.length - 1 && <br />}</>)}</h1></div>
        <div class="hero-aside"><p>{t.intro}</p><div class="hero-actions"><a class="button" href="#journey">{t.start}<span aria-hidden="true">↗</span></a><a class="text-link" href={REPO}>{t.source} ↗</a></div></div>
      </div>
      <div class="hero-caption"><span>{t.heroNote}</span><span aria-hidden="true">SCROLL TO EXPLORE ↓</span></div>
    </section>

    <section class="section why-section" id="why" aria-labelledby="why-title">
      <div class="section-heading"><p class="eyebrow">{t.whyLabel}</p><div class="heading-row"><h2 id="why-title">{t.whyTitle}</h2><p>{t.whyIntro}</p></div></div>
      <div class="problem-essays">{t.problems.map((problem, i) => <article><div><span class="essay-number">0{i + 1}</span><h3>{problem.title}</h3></div><div><p>{problem.problem}</p><p class="approach"><span>{t.approach}</span>{problem.approach}</p></div></article>)}</div>
    </section>

    <section class="collab-section" id="journey" aria-labelledby="journey-title"><div class="section">
      <div class="section-heading"><p class="eyebrow">{t.journeyLabel}</p><div class="heading-row"><h2 id="journey-title">{t.journeyTitle}</h2><p>{t.journeyIntro}</p></div></div>
      <p class="journey-scope">{t.journeyScope}</p>
      <Collaboration client:load t={t} />
      <noscript><div class="journey-transcript">{t.deliverySteps.map(step => <article><h3>{step.phase} — {step.title}</h3><p>{step.body}</p><p>{step.ai}</p><p>{step.human}</p><p>{step.feedback}</p><p>{step.result}</p></article>)}</div></noscript>
      <div class="cooperation-note"><h3>{t.cooperationTitle}</h3><p>{t.cooperationBody}</p></div>
    </div></section>

    <section class="section roles-section" id="roles" aria-labelledby="roles-title">
      <div class="section-heading"><p class="eyebrow">{t.rolesLabel}</p><div class="heading-row"><h2 id="roles-title">{t.rolesTitle}</h2><p>{t.rolesIntro}</p></div></div>
      <div class="role-cards">{t.roles.map((role, i) => <article class={`role-card ${role.id}`}>
        <div class="role-identity"><div class="role-card-top"><span class="role-number">0{i + 1}</span><span class="tiny-label">{role.en}</span></div><h3>{role.verb}</h3><code class="package-name">rivo + {role.package}</code></div>
        <div class="role-content">
          <p class="role-description">{role.description}</p>
          <dl><dt>{t.input}</dt><dd>{role.input}</dd><dt>{t.output}</dt><dd>{role.output}</dd></dl>
          <ol class="role-journey">{role.journey.map(step => <li>{step}</li>)}</ol>
          <div class="role-prompt"><span class="tiny-label">{t.promptLabel}</span><blockquote>{role.prompt}</blockquote></div>
          <details class="skill-details"><summary>{t.skillsLabel}<span>{role.skills.length} {t.skillUnit}<span aria-hidden="true"> +</span></span></summary><ul>{role.skills.map(([name, desc]) => <li><a href={skillUrl(name)}><span>{desc}</span><code>{name} ↗</code></a></li>)}</ul></details>
        </div>
      </article>)}</div>
      <div class="shared-methods"><div><span class="foundation-mark" aria-hidden="true"></span><code>rivo</code><h3>{t.sharedTitle}</h3><p>{t.sharedDesc}</p></div><details class="method-details"><summary>{t.sharedLabel}<span aria-hidden="true"> +</span></summary><ul>{t.sharedSkills.map(([name, desc]) => <li><a href={skillUrl(name)}><span>{desc}</span><code>{name} ↗</code></a></li>)}</ul></details></div>
    </section>

    <section class="section resume-section" aria-labelledby="resume-title">
      <div><h2 id="resume-title">{t.resumeTitle}</h2><p>{t.resumeBody}</p><p class="resume-note">{t.resumeNote}</p></div>
      <blockquote><code>resume</code><p>{t.resumePrompt}</p></blockquote>
    </section>

    <section class="start-section" id="start" aria-labelledby="start-title"><div class="section"><div class="section-heading"><p class="eyebrow">{t.stLabel}</p><h2 id="start-title">{t.stTitle}</h2></div><Start client:load t={t} /><noscript><div class="static-install"><a href={`${REPO}/blob/main/README.md#安装`}>{t.staticInstall} ↗</a></div></noscript></div></section>
  </main>
  <footer class="site-footer"><div><a class="wordmark" href={home[lang]}>Rivo<span class="brand-dot" aria-hidden="true"></span></a><p>{t.footLine}</p><a class="text-link" href={REPO}>{t.footSource} ↗</a></div><div class="footer-bottom"><span>{t.footNote}</span><nav aria-label="Resources"><a href={`${REPO}/blob/main/README.md`}>README ↗</a><a href={`${REPO}/blob/main/CONTRIBUTING.md`}>CONTRIBUTING ↗</a><a href={`${REPO}/blob/main/LICENSE`}>LICENSE ↗</a></nav><span>© 2026 reflux-studio</span></div><div class="footer-signature" aria-hidden="true">Rivo<i></i></div></footer>
  <script>
    document.querySelectorAll('.mobile-nav a').forEach(link => link.addEventListener('click', () => link.closest('details')?.removeAttribute('open')))
  </script>
</body>
</html>
