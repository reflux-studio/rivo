---
import '../styles/site.css'
import { site, type Locale } from '../i18n/site'
import { GH, REPO, TREE } from '../lib/data'
import HeroDemo from './HeroDemo'
import Sequence from './Sequence'
import Stages from './Stages'
import Start from './Start'

interface Props { lang: Locale }
const { lang } = Astro.props
const t = site[lang]
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const home = { zh: `${base}/`, en: `${base}/en/` }
const url = new URL(home[lang], Astro.site)
const nav = [['why', t.navWhy], ['how', t.navHow], ['principles', t.navPrin], ['skills', t.navSkills], ['start', t.navStart]]
---

<!doctype html>
<html lang={t.meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f3ea" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang="zh" href={new URL(home.zh, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(home.en, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(home.zh, Astro.site)} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Noto+Serif+SC:wght@500;600;700;900&family=Noto+Sans+SC:wght@400;500;700&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <a class="skip" href="#why">{t.skip}</a>
    <div class="grain" aria-hidden="true"></div>

    <nav class="top">
      <div class="in">
        <a class="logo" href="#top" aria-label="Rivo"><b>Rivo</b><i></i></a>
        <div class="links">{nav.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}</div>
        <div class="tools">
          <div class="seg" role="group" aria-label="Language">
            <a href={home.zh} hreflang="zh" aria-current={lang === 'zh' ? 'page' : undefined}>中</a>
            <a href={home.en} hreflang="en" aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
          </div>
          <a class="gh" href={REPO} target="_blank" rel="noopener">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path></svg>GitHub
          </a>
        </div>
      </div>
    </nav>

    <header class="hero" id="top">
      <div class="lines" aria-hidden="true"></div>
      <div class="in">
        <div class="l">
          <div class="kick"><span>v0.10.2</span><span>{t.kicker}</span></div>
          <h1>
            <span class="ln">{t.h1a}<span class="hl">{t.h1b}</span>{t.h1c}</span>
            <span class="ln">{t.h1d}</span>
            <span class="ln">{t.h1e}</span>
          </h1>
          <p class="sub">{t.heroSub}</p>
          <div class="cta">
            <a class="btn" href="#start">{t.ctaStart}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a>
            <a class="btn o" href={REPO} target="_blank" rel="noopener">{t.ctaGh}<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg></a>
          </div>
          <div class="tags"><span>Claude Code</span><span>Codex</span><span>MIT</span></div>
        </div>
        <HeroDemo client:load t={t} />
      </div>
    </header>

    <section id="why">
      <div class="wrap sec">
        <div class="lab" data-reveal><b>§ 01</b><span>{t.navWhy}</span></div>
        <div class="hd2" style="gap:48px">
          <h2 data-reveal>{t.whyT1}<br /><em>{t.whyT2}</em></h2>
          <div class="why">
            <div data-reveal><span>{t.whyLa}</span><p>{t.whyP1}</p></div>
            <div data-reveal><span>{t.whyLb}</span><p>{t.whyP2}</p></div>
          </div>
        </div>
      </div>
    </section>

    <section id="how" class="alt">
      <div class="wrap stack" style="gap:56px">
        <div class="sec">
          <div class="lab" data-reveal><b>§ 02</b><span>{t.navHow}</span></div>
          <div class="hd2" data-reveal><h2>{t.howTitle}</h2><p class="lead">{t.howSub}</p></div>
        </div>
        <Stages client:visible t={t} />
      </div>
    </section>

    <section>
      <div class="wrap stack">
        <Sequence client:visible t={t} />
      </div>
    </section>

    <section class="alt">
      <div class="wrap stack">
        <div class="sec">
          <div class="lab" data-reveal><b>§ 04</b><span>{t.planLabel}</span></div>
          <div class="hd2" data-reveal><h2>{t.planTitle}</h2><p class="lead">{t.planSub}</p></div>
        </div>
        <div class="plan">
          <div class="toc" data-reveal>
            <div class="cap"><b>plan.md</b><span>{t.tocCap}</span></div>
            {t.chapters.map(([title, desc], i) => <div class="ch" style={`--i:${i}`}><i>{i + 1}</i><b>{title}</b><u aria-hidden="true"></u><span>{desc}</span></div>)}
          </div>
          <div class="tree" data-reveal>
            <div class="cap"><span>{t.treeCap}</span><span>tree</span></div>
            {TREE.map(([pre, name, ni], i) => <div class="n" style={`--i:${i}`}><span><span class="p">{pre}</span><span class={name.endsWith('/') ? 'd' : ''}>{name === 'issues/' ? `issues/${t.issue}/` : name}</span></span><span>{t.tree[ni] || ' '}</span></div>)}
            <div class="note">{t.treeNote}</div>
          </div>
        </div>
      </div>
    </section>

    <section id="principles">
      <div class="wrap stack" style="gap:56px">
        <div class="sec">
          <div class="lab" data-reveal><b>§ 05</b><span>{t.navPrin}</span></div>
          <h2 class="hd2" data-reveal>{t.prinTitle}</h2>
        </div>
        <div class="prin">
          {t.principles.map(([title, desc], i) => <div class="pr" data-reveal><i>{i + 1}</i><div><b>{title}</b><span>{desc}</span></div></div>)}
        </div>
        <a data-reveal style="align-self:flex-start;font-size:15px" href={`${REPO}/blob/main/CONTRIBUTING.md`} target="_blank" rel="noopener">{t.prinMore} ↗</a>
      </div>
    </section>

    <section id="skills" class="alt">
      <div class="wrap stack">
        <div class="sec">
          <div class="lab" data-reveal><b>§ 06</b><span>{t.navSkills}</span></div>
          <div class="hd2" data-reveal><h2>{t.skTitle}</h2><p class="lead">{t.skSub}</p></div>
        </div>
        <div class="tr">
          <a class="entry" data-reveal href={`${GH}using-rivo/SKILL.md`} target="_blank" rel="noopener"><b>using-rivo</b><span>{t.skEntry}</span></a>
          <div class="vl" aria-hidden="true"></div>
          <div class="sc">
            <div class="in">
              <div class="hl2" aria-hidden="true"></div>
              <div class="sg">
                {t.stageSkills.map(([name, stage, desc, refs], i) => (
                  <div data-reveal>
                    <div class="vl" aria-hidden="true"></div>
                    <a class="kc" href={`${GH}${name}/SKILL.md`} target="_blank" rel="noopener">
                      <div class="m"><span>0{i + 1} · {stage}</span><span>↗</span></div>
                      <span class="nm">{name}</span>
                      <span class="ds">{desc}</span>
                      <div class="rf">{(refs as string[]).map((r) => <span>{r}</span>)}</div>
                    </a>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
        <div class="meth">
          <div class="t" data-reveal><b>{t.skMethods}</b><span>{t.skMethodsSub}</span></div>
          <div class="mg">
            {t.methodSkills.map(([name, desc]) => <a class="mc" data-reveal href={`${GH}${name}/SKILL.md`} target="_blank" rel="noopener"><b>{name}</b><span>{desc}</span></a>)}
          </div>
        </div>
      </div>
    </section>

    <section id="start" style="border-bottom:0">
      <div class="wrap stack">
        <div class="sec">
          <div class="lab" data-reveal><b>§ 07</b><span>{t.navStart}</span></div>
          <h2 class="hd2" data-reveal>{t.stTitle}</h2>
        </div>
        <Start client:visible t={t} />
      </div>
    </section>

    <footer>
      <div class="in">
        <div class="top">
          <p data-reveal>{t.footLine}</p>
          <div data-reveal><a class="btn" href={REPO} target="_blank" rel="noopener">{t.footCta} ↗</a></div>
        </div>
        <div class="links2">
          <a href={`${REPO}/blob/main/README.md`} target="_blank" rel="noopener">README</a>
          <a href={`${REPO}/blob/main/CONTRIBUTING.md`} target="_blank" rel="noopener">CONTRIBUTING</a>
          <a href={`${REPO}/blob/main/LICENSE`} target="_blank" rel="noopener">MIT License</a>
          <span>© 2026 reflux-studio</span>
        </div>
      </div>
      <div class="big" aria-hidden="true"><span>Rivo</span><i></i></div>
    </footer>

    <script is:inline>
      // 滚动显现：进入视口时加上 .shown；不支持或减弱动效时直接显示
      ;(() => {
        const els = document.querySelectorAll('[data-reveal]')
        if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
          els.forEach((e) => e.classList.add('shown'))
          return
        }
        const io = new IntersectionObserver(
          (es) => es.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('shown')
              io.unobserve(e.target)
            }
          }),
          { rootMargin: '0px 0px -8% 0px' }
        )
        const watch = (el) => {
          const i = el.parentElement ? [...el.parentElement.children].indexOf(el) : 0
          el.style.transitionDelay = Math.min(i, 5) * 70 + 'ms'
          io.observe(el)
        }
        els.forEach(watch)
        // 岛组件水合后才出现的 data-reveal 元素
        new MutationObserver(() => document.querySelectorAll('[data-reveal]:not(.shown)').forEach(watch)).observe(document.body, { childList: true, subtree: true })
      })()
    </script>
  </body>
</html>
