#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
content="Rivo 公共方法可用。领域工作请先按需读取公共入口 ${PLUGIN_ROOT}/skills/using-rivo/SKILL.md，确认角色与材料；独立方法完成当前请求即结束，不自动启动完整流程。"
escape_json() {
 local s="$1"
 s="${s//\\/\\\\}"
 s="${s//\"/\\\"}"
 s="${s//$'\n'/\\n}"
 s="${s//$'\r'/\\r}"
 s="${s//$'\t'/\\t}"
 printf '%s' "$s"
}
content="$(escape_json "$content")"
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
 printf '{"additional_context":"%s"}\n' "$content"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
 printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$content"
else
 printf '{"additionalContext":"%s"}\n' "$content"
fi
